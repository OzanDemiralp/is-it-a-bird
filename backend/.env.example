# Copy to backend/.env and adjust. Never commit the real .env.

# Comma-separated browser origins allowed to call the API (Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds an OpenSky response is reused for the same bounding box.
CACHE_TTL_SECONDS=5

# Optional OpenSky OAuth2 API client (Account page on opensky-network.org).
# Leave empty for anonymous access, which has reduced rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Seconds to remember that adsbdb has no data for a callsign/aircraft (default 1 hour).
DETAILS_UNKNOWN_TTL_SECONDS=3600

# Seconds to cache aircraft details such as type and registration (default 24 hours).
AIRCRAFT_INFO_TTL_SECONDS=86400
